# Google OAuth — create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials
# Add BOTH authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google      (base sign-in)
#   http://localhost:3000/api/gmail/callback             (Gmail read scope)
# Also enable the Gmail API for the project and add the
# .../auth/gmail.readonly scope on the OAuth consent screen.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Durable token store (required on Vercel / any multi-instance deploy).
# Vercel → Storage → Create → Upstash Redis gives you both values.
# Without these, Gmail tokens are held in-memory only and are lost when the
# callback and scan run on different serverless instances — the scan then
# fails with "Gmail is not connected for this card". Local `next dev` works
# without them (single process), so they're optional for local-only use.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── RAG additions (Supabase + LLMs + GitHub dispatch) ───────────────────────
# Supabase project — Settings → API. The SERVICE ROLE key is server-only; it
# bypasses RLS and must never reach the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM + embeddings for the /api/ask query path (the worker uses its own copies
# set as GitHub Actions secrets).
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=your-openai-key

# GitHub dispatch — lets /api/gmail/ingest trigger the backfill workflow.
# GH_DISPATCH_TOKEN = a fine-grained PAT with Actions: read/write on the repo.
GH_REPO=your-github-owner/your-repo
GH_DISPATCH_TOKEN=your-fine-grained-pat
